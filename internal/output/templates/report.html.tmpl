<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>acurl report: {{.Title}}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none'%3E%3Cpath d='M3.2 4.4L8.6 9.8L3.2 15.2' stroke='%231f1534' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3Crect x='11' y='11.4' width='5.6' height='5.6' rx='1.4' fill='%236a2bc4'/%3E%3C/svg%3E">
<style>
/* Design tokens follow tragent.io. The report is self-contained: no web fonts. */
:root{--canvas:#f6f4fa;--panel:#fdfcff;--surface:#f0ecf7;--ink:#1f1534;--gray-2:#5f5577;--line:#e3ddee;--line-2:#ece7f4;--dot:#d4cbe3;--brand:#6a2bc4;--brand-soft:#efe6fb;
--pass:#0f7a46;--pass-soft:#e6f4ec;--fail:#a8383b;--fail-soft:#fbeeee;--warn:#935600;--warn-soft:#fdf1dc;--info:#0b62b8;--info-soft:#e6f0fb;
--shadow:0 1px 3px #1f15340f,0 28px 64px -30px #1f153442;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}
*{box-sizing:border-box}body{margin:0;color:var(--ink);font:15px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--canvas)}
main{max-width:1100px;margin:0 auto;padding:32px 16px 48px}a{color:var(--brand)}
.brand{display:flex;align-items:center;gap:8px;font-weight:600;font-size:18px;letter-spacing:-.035em;margin-bottom:24px}
section{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);overflow:hidden;margin-bottom:28px}
.head{display:flex;gap:24px;align-items:center;flex-wrap:wrap;justify-content:space-between;padding:22px 26px;border-bottom:1px solid var(--line)}
h1{font:500 15px var(--mono);margin:0;word-break:break-all}h2{font-size:15px;font-weight:500;margin:0;padding:18px 26px 8px}
.muted{color:var(--gray-2);font-size:14px}.pad{padding:0 26px 18px}
.score{display:flex;align-items:baseline;gap:6px}.score b{font-size:48px;font-weight:500;line-height:1;letter-spacing:-.04em}
.grade{font:500 13px var(--mono);padding:2px 8px;border-radius:4px;margin-left:8px}
.g-A,.g-B{background:var(--pass-soft);color:var(--pass)}.g-C{background:var(--warn-soft);color:var(--warn)}.g-D,.g-F,.g--{background:var(--fail-soft);color:var(--fail)}
table{border-collapse:collapse;width:100%;font-size:14px}th{text-align:left;font-weight:500;font-size:13px;color:var(--gray-2);padding:9px 26px;background:var(--surface);border-bottom:1px solid var(--line)}
td{padding:10px 26px;border-bottom:1px solid var(--line-2);vertical-align:top}td.m{font-family:var(--mono);font-size:13px}
.pill{display:inline-block;padding:1px 8px;border-radius:4px;font-size:13px;white-space:nowrap}
.c-allowed{background:var(--pass-soft);color:var(--pass)}.c-blocked,.c-error{background:var(--fail-soft);color:var(--fail)}.c-challenged,.c-rate-limited{background:var(--warn-soft);color:var(--warn)}
.c-cloaked{background:var(--brand-soft);color:var(--brand)}.c-robots-disallowed{background:var(--info-soft);color:var(--info)}
.checks{list-style:none;padding:0 26px;margin:0}.checks li{padding:8px 0;border-bottom:1px solid var(--line-2)}.ok{color:var(--pass)}.bad{color:var(--fail)}
.fix{margin:8px 26px;padding:9px 12px;background:var(--surface);border-radius:6px;font-size:14px}
pre.diff{font:12px/1.5 var(--mono);white-space:pre-wrap;margin:8px 0 0;max-height:360px;overflow:auto;background:var(--surface);padding:10px;border-radius:6px}
.ins{color:var(--pass)}.del{color:var(--fail)}.skip{color:var(--gray-2)}details{padding:8px 26px}summary{cursor:pointer;font-weight:500}
footer{font-size:13px;color:var(--gray-2)}
</style>
</head>
<body>
<main>
<div class="brand"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.2 4.4L8.6 9.8L3.2 15.2" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><rect x="11" y="11.4" width="5.6" height="5.6" rx="1.4" fill="var(--brand)"/></svg>acurl report</div>
{{range $i, $r := .Reports}}
<section>
<div class="head">
  <div>
    <h1>{{$r.URL}}</h1>
    <div class="muted">Checked {{$r.Timestamp.Format "2006-01-02 15:04 MST"}} with {{len $r.Results}} profiles</div>
  </div>
  {{with $r.Score}}{{if .Note}}<div class="score"><span class="grade g--">not scored</span></div>{{else}}
  <div class="score"><b>{{.Value}}</b><span class="muted">/100</span><span class="grade g-{{.Grade}}">{{.Grade}}</span></div>{{end}}{{end}}
</div>

{{with $r.Score}}{{if .Note}}<p class="fix">{{.Note}}</p>{{else}}
<h2>AI readiness</h2>
<div><ul class="checks">
{{range .Checks}}{{if .Applies}}<li>{{if .Passed}}<span class="ok">✓</span>{{else}}<span class="bad">✗</span>{{end}} <b>{{.Title}}</b> <span class="muted">{{printf "%.1f" .Points}}/{{.Weight}} · {{.Detail}}</span></li>{{end}}{{end}}
</ul></div>
{{$fixes := failed .Checks}}{{if $fixes}}<h2>How to improve</h2>{{range $fixes}}<div class="fix"><b>{{.Title}}.</b> {{.Recommendation}}</div>{{end}}{{end}}
{{end}}{{end}}

<h2>Results</h2>
<div><table>
<thead><tr><th>Profile</th><th>Category</th><th>Status</th><th>Time</th><th>Size</th><th>Result</th><th>Details</th></tr></thead>
<tbody>
{{range $r.Results}}<tr><td><b>{{.Profile}}</b></td><td class="muted">{{.Category}}</td><td class="m">{{status .}}</td><td class="m">{{timeText .}}</td><td class="m">{{sizeText .}}</td><td><span class="pill c-{{.Classification}}">{{.Classification}}</span></td><td>{{details .}}</td></tr>
{{end}}</tbody></table></div>

{{with $r.Render}}<h2>JavaScript rendering</h2><div class="pad">{{if .Error}}<span class="bad">{{.Error}}</span>{{else}}{{percent .JSOnlyShare}} of the visible text only appears after JavaScript runs ({{.RawTextLength}} → {{.RenderedTextLength}} characters).{{end}}</div>{{end}}

{{$diffs := index $.Diffs $i}}{{if $diffs}}<h2>What agents saw differently</h2>
{{range $diffs}}<details><summary>{{.Profile}} vs {{.Baseline}} <span class="muted">({{percent .Similarity}} similar)</span></summary>
<pre class="diff">{{range .Lines}}{{if eq .Op 1}}<span class="ins">+ {{.Text}}</span>{{else if eq .Op 2}}<span class="del">- {{.Text}}</span>{{else if eq .Op 3}}<span class="skip">  …</span>{{else}}  {{.Text}}{{end}}
{{end}}</pre></details>{{end}}{{end}}
</section>
{{end}}

<footer>
<p>{{.Caveat}}</p>
<p>Generated by <a href="https://github.com/tragent-io/acurl">acurl</a> {{.Version}}, a free, open-source tool by <a href="https://tragent.io">tragent.io</a>.</p>
</footer>
</main>
</body>
</html>
